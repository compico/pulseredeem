{
  "name": "pulseredeem",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "node src/server.js",
    "server:dev": "node --watch src/server.js",
    "dev": "node ./scripts/dev-build.mjs",
    "build": "vite build",
    "build:modules": "node ./scripts/module-compile.mjs",
    "sync": "node ./scripts/sync-addon.mjs",
    "build:sync": "npm run build && npm run sync",
    "test": "node --test"
  },
  "dependencies": {
    "@pulsesync/addon-sdk": "0.18.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.1",
    "oxfmt": "0.75.0",
    "react": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
